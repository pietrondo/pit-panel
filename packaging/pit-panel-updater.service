[Unit]
Description=pit-panel self-updater
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pit-panel
Group=pit-panel
WorkingDirectory=/opt/pit-panel
Environment="PATH=/opt/pit-panel/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/opt/pit-panel/.venv/bin/python /opt/pit-panel/scripts/self_update.py
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/pit-panel /opt/pit-panel
CapabilityBoundingSet=
